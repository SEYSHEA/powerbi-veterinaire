{
  "name": "Vetoquinol",
  "dataColors": [
    "#008A90",
    "#388F43",
    "#7FB83F",
    "#4B686C",
    "#263C3F",
    "#FBD600",
    "#00595E",
    "#2E6B35",
    "#5E8F2F",
    "#6E8A8E",
    "#C4A600",
    "#A7A9AC"
  ],
  "foreground": "#263C3F",
  "foregroundNeutralSecondary": "#4B686C",
  "foregroundNeutralTertiary": "#A7A9AC",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F5F5",
  "backgroundNeutral": "#E3E8E8",
  "tableAccent": "#008A90",
  "good": "#388F43",
  "neutral": "#FBD600",
  "bad": "#C0504D",
  "maximum": "#00595E",
  "center": "#E3E8E8",
  "minimum": "#D9EAEA",
  "null": "#E3E8E8",
  "hyperlink": "#008A90",
  "visitedHyperlink": "#00595E",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#263C3F"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#263C3F"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#263C3F"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#4B686C"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E8E8"
              }
            },
            "radius": 10,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "Custom",
            "position": "Outer",
            "color": {
              "solid": {
                "color": "#263C3F"
              }
            },
            "transparency": 90,
            "shadowBlur": 8,
            "shadowDistance": 2,
            "shadowSpread": 0,
            "angle": 90
          }
        ],
        "padding": [
          {
            "top": 16,
            "bottom": 16,
            "left": 18,
            "right": 18
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#263C3F"
              }
            },
            "alignment": "left",
            "titleWrap": true
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#4B686C"
              }
            },
            "alignment": "left",
            "titleWrap": true
          }
        ],
        "divider": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "transparency": 0
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineStyle": "solid",
            "gridlineColor": {
              "solid": {
                "color": "#EDF0F0"
              }
            },
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#4B686C"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineStyle": "solid",
            "gridlineColor": {
              "solid": {
                "color": "#EDF0F0"
              }
            },
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#4B686C"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Bottom",
            "showTitle": false,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#4B686C"
              }
            }
          }
        ],
        "labels": [
          {
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#4B686C"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F5F5"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F5F5"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#008A90"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#008A90"
              }
            },
            "radius": 10,
            "width": 1
          }
        ],
        "fillCustom": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#008A90"
              }
            },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "accentBar": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "value": [
          {
            "$id": "default",
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "labelDisplayUnits": 1
          }
        ],
        "label": [
          {
            "$id": "default",
            "show": true,
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "listSlicer": {
      "*": {
        "value": [
          {
            "$id": "default",
            "fontSize": 11,
            "fontFamily": "Segoe UI",
            "fontColor": {
              "solid": {
                "color": "#263C3F"
              }
            }
          },
          {
            "$id": "selection:selected",
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#00595E"
              }
            }
          }
        ],
        "accentBar": [
          {
            "$id": "selection:selected",
            "show": true,
            "color": {
              "solid": {
                "color": "#008A90"
              }
            },
            "position": "Left",
            "width": 4
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "stylePreset": [
          {
            "name": "None"
          }
        ],
        "title": [
          {
            "show": true
          }
        ],
        "grid": [
          {
            "rowPadding": 6,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EDF0F0"
              }
            },
            "gridVertical": false,
            "outlineColor": {
              "solid": {
                "color": "#E3E8E8"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#263C3F"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F7F9F9"
              }
            },
            "fontSize": 10.5,
            "fontColor": {
              "solid": {
                "color": "#263C3F"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#263C3F"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F4F5F5"
              }
            }
          }
        ]
      },
      "None": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#263C3F"
              }
            }
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F7F9F9"
              }
            }
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "dataPoint": [
          {
            "fill": {
              "solid": {
                "color": "#008A90"
              }
            }
          }
        ],
        "labels": [
          {
            "show": false
          }
        ],
        "legend": [
          {
            "show": false
          }
        ],
        "layout": [
          {
            "clusteredGapSize": 6
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "dataPoint": [
          {
            "fill": {
              "solid": {
                "color": "#008A90"
              }
            }
          }
        ],
        "bubbles": [
          {
            "bubbleSize": -25
          }
        ],
        "markers": [
          {
            "transparency": 25
          }
        ],
        "trend": [
          {
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#263C3F"
              }
            },
            "style": "dashed",
            "width": 2,
            "transparency": 30
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": true
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": true
          }
        ],
        "legend": [
          {
            "show": false
          }
        ]
      }
    },
    "filledMap": {
      "*": {
        "stroke": [
          {
            "show": true,
            "strokeColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "strokeWidth": 1
          }
        ],
        "mapStyles": [
          {
            "showLabels": false
          }
        ],
        "legend": [
          {
            "show": false
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ],
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 90
          },
          {
            "$id": "hover",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 78
          },
          {
            "$id": "selected",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#008A90"
              }
            },
            "transparency": 0
          }
        ],
        "text": [
          {
            "$id": "default",
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          },
          {
            "$id": "selected",
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "shape": [
          {
            "tileShape": "rectangleRounded",
            "rectangleRoundedCurve": 6
          }
        ],
        "layout": [
          {
            "cellPadding": 8
          }
        ]
      }
    }
  }
}